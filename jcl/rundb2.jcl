//Z72304J JOB (FB3),'RUN RECON02',CLASS=A,MSGCLASS=H,NOTIFY=&SYSUID
//DEL     EXEC PGM=IEFBR14
//D1       DD DSN=Z72304.RECON.MATCHED,DISP=(MOD,DELETE),SPACE=(TRK,1)
//D2       DD DSN=Z72304.RECON.UNMATCH,DISP=(MOD,DELETE),SPACE=(TRK,1)
//D3       DD DSN=Z72304.RECON.ERRORS,DISP=(MOD,DELETE),SPACE=(TRK,1)
//RUN     EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=Z72304.LOAD,DISP=SHR
//         DD DSN=DSND10.DBDG.SDSNEXIT,DISP=SHR
//         DD DSN=DSND10.SDSNLOAD,DISP=SHR
//         DD DSN=CEE.SCEERUN,DISP=SHR
//         DD DSN=CEE.SCEERUN2,DISP=SHR
//IN1      DD DSN=Z72304.RECON.IN1,DISP=SHR
//IN2      DD DSN=Z72304.RECON.IN2,DISP=SHR
//MATCHED  DD DSN=Z72304.RECON.MATCHED,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//UNMATCH  DD DSN=Z72304.RECON.UNMATCH,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//ERRFILE  DD DSN=Z72304.RECON.ERRORS,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DBDG)
  RUN PROGRAM(RECON02) PLAN(Z72304)
  END
/*

